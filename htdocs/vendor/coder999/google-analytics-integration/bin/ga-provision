#!/usr/bin/env php
<?php

declare(strict_types=1);

// Works both inside this repo and when installed into a site's vendor/.
$loaded = false;
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}
if (!$loaded) {
    fwrite(STDERR, "Could not find an autoloader. Run 'composer install', or install this package into a site's vendor/.\n");
    exit(1);
}

use Coder999\Ga4\Cache\FileCache;
use Coder999\Ga4\Cli;
use Coder999\Ga4\Http\CurlHttp;

$home = $_SERVER['HOME'] ?? getenv('HOME') ?: '';
$cacheDir = getenv('GA_CACHE_DIR') ?: ($home !== '' ? $home . '/.cache/ga4-provision' : sys_get_temp_dir() . '/ga4-provision-' . getmypid());

$result = (new Cli(new CurlHttp(), new FileCache($cacheDir)))->run(
    array_slice($argv, 1),
    getenv() ?: []
);

fwrite($result['code'] === 0 ? STDOUT : STDERR, $result['out']);
exit($result['code']);
