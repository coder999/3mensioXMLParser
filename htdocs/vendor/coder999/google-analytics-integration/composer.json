{
    "name": "coder999/google-analytics-integration",
    "description": "GA4 Data API reporting client, gtag renderer, and property provisioning CLI. No runtime dependencies, no database.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "bin": ["bin/ga-provision"],
    "autoload": {
        "psr-4": {
            "Mtmd\\Ga4\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mtmd\\Ga4\\Tests\\": "tests/"
        }
    }
}
