<?php
// Values are base64-encoded by the deploy workflow before substitution so that
// quotes/backslashes in a secret cannot break the PHP string literals here.
return [
    'IDENTITY_DB_HOST' => base64_decode('$SINGLE_AUTH_DB_HOST_B64'),
    'IDENTITY_DB_PORT' => (int) base64_decode('$SINGLE_AUTH_DB_PORT_B64'),
    'IDENTITY_DB_NAME' => base64_decode('$SINGLE_AUTH_DB_NAME_B64'),
    'IDENTITY_DB_USER' => base64_decode('$SINGLE_AUTH_DB_USER_B64'),
    'IDENTITY_DB_PASS' => base64_decode('$SINGLE_AUTH_DB_PASS_B64'),
];
