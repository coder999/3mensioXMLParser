return [
    'GA4_PROPERTY_ID' => base64_decode('$GA4_PROPERTY_ID_B64'),
    'GA_SERVICE_ACCOUNT_JSON' => base64_decode('$GA_SERVICE_ACCOUNT_JSON_B64'),
];
